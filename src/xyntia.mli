open Xyntia_utils

(** Type of the arguments required to launch Xyntia synthesis *)
type synthesis_args = {
    heuristic : Heuristic.kind ; (** the S-metaheuristic to use for synthesis (default: {!Xyntia_utils.Heuristic.kind.ILS}) *)
    time      : int    ; (* Synthesis timeout in seconds *)
    dist : Distance.kind     ; (** Distance to use (default: {!Xyntia_utils.Distance.kind.LOGARITH})*)
    maxdepth : int     ; (* Maximun size of the AST generated by Xyntia (default: max_int) *)
    repeat: int     ;    (* Repeat synthesis n times until a success (default: no)*) 
    formula : Sampler.groundtruth; (* Either the path to smt formula or the Binsec formula. Used to check equivalence *)
    smt : string option;
    smt_to : int option;
    cegis : bool;        (* Use Counter-example Guided Inductive Synthesis *)
    infrules : Distance.infrule list;   (** List of inference rules to use (default []) *)
    noguidance : bool;   
    rules_combinator : string;
    check : bool;
}

type cegis_info = {
    nb_equiv_checks : int;
    time_equiv_check : float;
}

type target_info = {
    orig_size : int;
}

(** Result of the synthesis, including informations about the synthesis, the equivalence checking, 
the counter-example guided inductive synthesis (if used) and the target expression *)
type synthesis_result = {
    synthesis: Heuristic.summary;
    equiv: Checker.equiv_answer;
    cegis : cegis_info option;
    target : target_info;
}

(** Default set of arguments for Xyntia synthesis. 
    It launches Xyntia with the ILS S-metaheuristic, a 1 min timeout, the log-arithmetic distance, 
    no formula, no equivalence checking, no inference rules, no maximum AST depth and no repeats
*)
val default_args : synthesis_args

(** Predefined set of inference rules including all the rules from the CCS'25 paper *)
val all_inference_rules : Distance.infrule list

(** Predefined set of inference rules including all the rules for MBA operators *)
val mba_inference_rules : Distance.infrule list

(** 
    Generate inputs using Xyntia default strategy i.e., 100 samples including: 
    - 5 constant vectors (0), (1), (-1), (max_signed), (min_signed)
    - 85 random vectors withing [-50; 50]
    - 10 fully random vectors
*)
val auto_sample : Tree.variable array -> Oracle.inputs array

(** Generate the inputs required to use the Affine Plus proprocess *)
val sample_affineplus : Tree.variable array -> Oracle.inputs array

(** Generate the inputs required to use the Affine Xor proprocess *)
val sample_affinexor : Tree.variable array -> Oracle.inputs array

(** Run Xyntia over the defined oracle, set of mutations (i.e., set of operators) and synthesis arguments *)
val run : (module Oracle.ORACLE) -> (module Mutations.MUTATIONS) -> synthesis_args -> synthesis_result

val oracle_from_json : int -> int -> Yojson.Basic.t -> (module Oracle.ORACLE)
val oracle_from_file : int -> int -> string -> (module Oracle.ORACLE)

(** Return the sygus problem associated with the oracle and mutations (i.e., set of operators).
    The result can be directly fed to standard synthesizers like CVC5 *)
val get_sygus : (module Oracle.ORACLE) -> (module Mutations.MUTATIONS) -> string